@model EmployeeDetailDto
@{
    Layout = "Admin/_AdminLayout";
    ViewData["Title"] = "Profil";
}

@section Style {
    <style>
      /*------------------------------------------------------------------
          Fancybox Gallery Section   
      -------------------------------------------------------------------*/
      
      .gallery_section_inner .column {
          background: #fff;
          box-shadow: 0 0 13px -10px #000;
          overflow: hidden;
      }
      
      .heading_section {
          border-top: solid #1ed085 2px;
          background: #15283c;
      }
      
      .heading_section h4 {
          color: #fff;
          margin: 0;
          font-weight: 200;
          text-align: center;
          padding: 16px 0 16px;
          font-size: 15px;
      }
   </style>
    <link href="~/lib/fancybox/css/jquery.fancybox.css" rel="stylesheet" />
}

<div class="breadcrumbs">
    <div class="col-sm-4">
        <div class="page-header float-left">
            <div class="page-title">
                <h1>Dashboard</h1>
            </div>
        </div>
    </div>
    <div class="col-sm-8">
        <div class="page-header float-right">
            <div class="page-title">
                <ol class="breadcrumb text-right">
                    <li class="active">Dashboard</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="content mt-3">
    <div class="col-sm-12">
        <div class="alert  alert-success alert-dismissible fade show" role="alert">
            <span class="badge badge-pill badge-success">Success</span> You successfully read this important alert message.
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    </div>

    <div class="container-fluid py-5" style="background-color: #eee;">
        <div class="row">
            <div class="col-lg-4">
                    <!-- Employee Card Summary-->
                    @await Component.InvokeAsync("EmployeeSummaryCard", new { employeeId = Model.EmployeeDto.Id })
                    <!-- Employee Card Summary-->
                    <!-- EmployeeImage Card-->
                    @await Component.InvokeAsync("EmployeeImageCard", new { employeeId = Model.EmployeeDto.Id })
                    <!-- EmployeeImage Card-->
            </div>
            <div class="col-lg-8">
                         <div class="card">
                             <div class="card-header">
                                 <h3>Çalışan Bilgileri</h3>
                                 </div>
                            <div class="card-body">
                               <div class="custom-tab">
                                  <nav>
                                     <div class="nav nav-tabs nav-justified" id="nav-tab" role="tablist">
                                        <a class="nav-item nav-link active" id="custom-nav-home-tab" data-toggle="tab" href="#custom-nav-profile" role="tab" aria-controls="custom-nav-profile" aria-selected="true">Profil Bilgileri</a>
                                         <a class="nav-item nav-link" id="custom-nav-contact-tab" data-toggle="tab" href="#custom-nav-address" role="tab" aria-controls="custom-nav-address" aria-selected="false">Adres Bilgileri</a>
                                     </div>
                                  </nav>
                                  <div class="tab-content pl-3 pt-2 mt-3" id="nav-tabContent">
                                     <div class="tab-pane fade show active" id="custom-nav-profile" role="tabpanel" aria-labelledby="custom-nav-home-tab">
                                        <table class="table border-bottom">
                                                            <thead>
                                                            <tr>
                                                                <th class="border-0" style="width: 30%;"></th>
                                                                <th class="border-0" style="width: 70%;"></th>
                                                            </tr>
                                                            </thead>
                                                            <tbody>
                                                            <tr>
                                                                <td class="border-0">
                                                                    <label asp-for="EmployeeDto.FirstName"></label>
                                                                </td>
                                                                <td class="text-muted border-0">@Model.EmployeeDto.FirstName</td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <label asp-for="EmployeeDto.LastName"></label>
                                                                </td>
                                                                <td class="text-muted">@Model.EmployeeDto.LastName</td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <label asp-for="EmployeeDto.UserName"></label>
                                                                </td>
                                                                <td class="text-muted">@Model.EmployeeDto.UserName</td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <label asp-for="EmployeeDto.GenderType"></label>
                                                                </td>
                                                                <td class="text-muted">@Model.EmployeeDto.GenderType.GetEnumDescription()</td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <label asp-for="EmployeeDto.IdendityNo"></label>
                                                                </td>
                                                                <td class="text-muted">@Model.EmployeeDto.IdendityNo</td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <label asp-for="EmployeeDto.PhoneNumber"></label>
                                                                </td>
                                                                <td class="text-muted">@Model.EmployeeDto.PhoneNumber</td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <label asp-for="EmployeeDto.Email"></label>
                                                                </td>
                                                                <td class="text-muted">@Model.EmployeeDto.Email</td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <label asp-for="EmployeeDto.DateOfBirth"></label>
                                                                </td>
                                                                <td class="text-muted">@(Model.EmployeeDto.DateOfBirth.HasValue ? Model.EmployeeDto.DateOfBirth.Value.ToString("dd/MM/yyyy") : "") </td>
                                                            </tr>
                                                            <tr>
                                                                <td>
                                                                    <label asp-for="EmployeeDto.Note"></label>
                                                                    </td>
                                                                <td class="text-muted">@Model.EmployeeDto.Note</td>
                                                                </tr>
                                                            <tr>
                                                                <td>Adres</td>
                                                                <td class="text-muted">@Model.EmployeeAddressSummaryDtos.FirstOrDefault(x=>x.DefaultAddress)?.AddressDetails</td>
                                                            </tr>
                                                            </tbody>
                                                        </table>
                                     </div>
                                      <div class="tab-pane fade" id="custom-nav-address" role="tabpanel" aria-labelledby="custom-nav-address-tab">
                                    <a asp-area="Admin" asp-controller="EmployeeAddress" asp-action="CreateEmployeeAddress" asp-route-employeeId="@Model.EmployeeDto.Id" class="btn btn-outline-primary mb-2">Adres Ekle</a>
                                          <div class="row">
                                        @foreach (var employeeAddress in @Model.EmployeeAddressSummaryDtos.OrderByDescending(a => a.Id))

                                        {
                                                  <div class="col-md-6 col-lg-12 col-xl-6 mb-3">
                                                      <div class="card" style="border-radius: 20px;">
                                                          <div class="card-header">
                                                              <h5 class="card-title">@employeeAddress.AddressTitle</h5>
                                                          </div>
                                                          <div class="card-body">
                                                              <div class="card-text" style="height: 200px">
                                                                  <p class="font-weight-bold">@employeeAddress.FullName</p>
                                                                  @if (employeeAddress.AddressDetails.Length < 150)
                                                                           {
                                                                               <p>
                                                                                   @employeeAddress.AddressDetails.Substring(0, employeeAddress.AddressDetails.Length)
                                                                               </p>
                                                                           }
                                                                           else
                                                                           {
                                                                               <p>
                                                                                   @employeeAddress.AddressDetails.Substring(0, employeeAddress.AddressDetails.Substring(0,150).LastIndexOf(" ", StringComparison.Ordinal))...
                                                                               </p>
                                                                           }
                                                                  <p class="text-muted">@employeeAddress.PhoneNumber</p>
                                                              </div>
                                                              <div class="d-flex justify-content-end">
                                                            <a asp-area="Admin" asp-controller="EmployeeAddress" asp-action="EmployeeAddressDetail" asp-route-addressId="@employeeAddress.Id" class="btn btn-info btn-sm">Detay</a>
                                                              </div>
                                                          </div>
                                                      </div>
                                                  </div>
                                              }
                                          </div>
                                      </div>
                                  </div>
                               </div>
                            </div>
                         </div>
                      </div>
        </div>
    </div>
</div> <!-- .content -->
@section Scripts {
        <script src="~/lib/inputmask/jquery.inputmask.min.js"></script>
        <script src="~/lib/fancybox/js/jquery.fancybox.min.js"></script>
        <script src="~/admin/js/employeeimage/employeeimage.js" asp-append-version="true"></script>
        <script asp-append-version="true">
            var app = app || {};
            app.Urls = app.Urls || {};
            app.ToastMessages = app.ToastMessages || {};
            app.ToastMessages.updateAddressMessage = '@TempData["UpdateAddressSuccess"]';
        </script>
    <script src="~/admin/js/employeeaccount/employeeaccount.js" asp-append-version="true"></script>
}
